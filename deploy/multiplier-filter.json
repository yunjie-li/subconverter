{
  "type": "Regex Filter",
  "args": {
    "regex": ["(?i)(?:^|[^\\d.])(?:0*2\\.\\d*[1-9]\\d*|0*(?:[3-9]\\d*|[1-9]\\d+)(?:\\.\\d+)?)\\s*(?:x|×|倍)(?![A-Za-z])|(?:倍率\\s*[:：=]?\\s*|[×x]\\s*)(?:0*2\\.\\d*[1-9]\\d*|0*(?:[3-9]\\d*|[1-9]\\d+)(?:\\.\\d+)?)(?![\\d.])"],
    "keep": false
  },
  "customName": "倍率上限 2x（排除 >2x）"
}
